# Copy to .env.local for local use; never commit real credentials.
# Public /demo works offline without configuration. Requirements below apply to real workspaces.
# Run npm run verify:env; for launch use -- --production --require-automation.

# --- APP ---
# Required; public-safe. Canonical origin for Auth, OAuth and mutation origin checks.
# HTTPS in hosted production; loopback supported only for local production-build QA.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- SUPABASE ---
# Required; public-safe. Supabase project API origin and publishable (never secret/service-role) key.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY
# Required; server-only. Checked runtime RPC writer, never a browser credential.
SUPABASE_SECRET_KEY=sb_secret_YOUR_KEY
# Optional alternative; server-only. Legacy service-role equivalent; not needed with secret key.
# SUPABASE_SERVICE_ROLE_KEY=YOUR_LEGACY_SERVICE_ROLE_KEY

# --- OPENAI / AI / RESEARCH ---
# Optional; server-only. Planner provider: gemini or openai (default openai if absent).
AI_PROVIDER=gemini
# Required when AI_PROVIDER=openai; server-only. OpenAI Responses/Structured Outputs.
# OPENAI_API_KEY=YOUR_OPENAI_API_KEY
# Optional; server-only. OpenAI Planner model fallback.
# OPENAI_PLANNER_MODEL=gpt-4.1-mini
# Required for research/review/outreach and Gemini Planner; server-only. Gemini provider credential.
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
# Optional; server-only. Default Gemini structured-output model.
GEMINI_MODEL=gemini-3.5-flash-lite
# Required for research; server-only. Bounded Tavily public evidence search.
TAVILY_API_KEY=YOUR_TAVILY_API_KEY
# Optional; server-only. Independent agent model overrides; no automatic optimization.
# PLANNER_MODEL=gemini-3.5-flash-lite
# RESEARCH_MODEL=gemini-3.5-flash-lite
# REVIEWER_MODEL=gemini-3.5-flash-lite
# OUTREACH_MODEL=gemini-3.5-flash-lite

# --- EMAIL / GMAIL / CRM ---
# Optional until Gmail is used; server-only. Google OAuth app identity and secret.
# Exact callback: NEXT_PUBLIC_APP_URL/api/integrations/gmail/callback
# Current consent is send-only; configuration does not grant mailbox-read access.
# GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
# GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET
# Optional until HubSpot is used; server-only. HubSpot OAuth app identity and secret.
# Exact callback: NEXT_PUBLIC_APP_URL/api/integrations/hubspot/callback
# HUBSPOT_CLIENT_ID=YOUR_HUBSPOT_CLIENT_ID
# HUBSPOT_CLIENT_SECRET=YOUR_HUBSPOT_CLIENT_SECRET
# Required when either integration is configured; server-only. 32 random bytes in base64.
# Back up separately: changing this key makes existing encrypted tokens unreadable.
# INTEGRATION_TOKEN_ENCRYPTION_KEY=YOUR_32_BYTE_BASE64_KEY

# --- AUTOMATION / JOB PROVIDER ---
# Optional; server-only. Enable after matching worker, callback and credentials are ready.
AUTOMATION_ENABLED=false
# Required when automation enabled; server-only. Trigger project and environment-matched API key.
# TRIGGER_PROJECT_REF=YOUR_TRIGGER_PROJECT_REF
# TRIGGER_SECRET_KEY=YOUR_TRIGGER_ENVIRONMENT_SECRET_KEY
# Required when automation enabled; server-only. >=32 random characters, same in app and worker.
# AUTOMATION_JOB_SIGNING_SECRET=YOUR_JOB_SIGNING_SECRET
# Optional fallback to NEXT_PUBLIC_APP_URL; server-only. Canonical app origin reachable by worker.
AUTOMATION_APP_URL=http://localhost:3000
# Optional; server-only, DEVELOPMENT ONLY. Permit 15-second due-test preparation; never sending.
AUTOMATION_ALLOW_TEST_JOBS=false

# --- OPTIONAL CONFIG ---
# Optional; server-only. Research ceiling from 1 to 20; workflow target may be lower.
MAX_RESEARCH_COMPANIES_PER_WORKFLOW=20
# Optional; server-only. Verified dated model rates; empty means unknown estimated cost.
# Map models to {inputUsdPerMillion,outputUsdPerMillion,cachedInputUsdPerMillion?,cacheWriteUsdPerMillion?,reasoningUsdPerMillion?,version}.
AI_MODEL_PRICING_JSON={}
# Optional; server-only. IANA timezone for analytics and daily usage totals.
WORKSPACE_TIMEZONE=Asia/Qyzylorda
# Optional; local test-only, public-safe. Playwright smoke origin; not app deployment config.
# E2E_BASE_URL=http://localhost:3001
# NODE_ENV, NEXT_RUNTIME, VERCEL and VERCEL_ENV are framework/platform-managed; do not override.

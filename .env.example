# Supabase Project URL and publishable key from the project Connect dialog,
# or from `supabase status` when using the local Supabase CLI.
# Copy this file to .env.local and replace both placeholders.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY

# Canonical app origin used to build the email confirmation callback URL.
# Add http://localhost:3000/auth/callback to Supabase Auth redirect allowlist.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-only runtime credentials. Never prefix these with NEXT_PUBLIC_.
# Use the Supabase secret key (sb_secret_...) from Settings > API Keys.
SUPABASE_SECRET_KEY=sb_secret_YOUR_KEY
# Legacy projects may use SUPABASE_SERVICE_ROLE_KEY instead of SUPABASE_SECRET_KEY.
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
# Optional override; must support the Responses API and strict Structured Outputs.
OPENAI_PLANNER_MODEL=gpt-4.1-mini

# Select Gemini for planning. Research always uses Tavily evidence + Gemini.
AI_PROVIDER=gemini
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-3.5-flash-lite
TAVILY_API_KEY=YOUR_TAVILY_API_KEY

# Optional independent model overrides (otherwise use the provider defaults above).
# PLANNER_MODEL=gemini-3.5-flash-lite
# RESEARCH_MODEL=gemini-3.5-flash-lite
# Hard research ceiling, supported range 1–20; each workflow also respects its target.
MAX_RESEARCH_COMPANIES_PER_WORKFLOW=20

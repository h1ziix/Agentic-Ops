# Supabase Project URL and publishable key from the project Connect dialog,
# or from `supabase status` when using the local Supabase CLI.
# Copy this file to .env.local and replace both placeholders.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY

# Canonical app origin used to build the email confirmation callback URL.
# Add http://localhost:3000/auth/callback to Supabase Auth redirect allowlist.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-only runtime credentials. Never prefix these with NEXT_PUBLIC_.
# Use the Supabase secret key (sb_secret_...) from Settings > API Keys.
SUPABASE_SECRET_KEY=sb_secret_YOUR_KEY
# Legacy projects may use SUPABASE_SERVICE_ROLE_KEY instead of SUPABASE_SECRET_KEY.
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
# Optional override; must support the Responses API and strict Structured Outputs.
OPENAI_PLANNER_MODEL=gpt-4.1-mini

# Select Gemini for planning. Research always uses Tavily evidence + Gemini.
AI_PROVIDER=gemini
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-3.5-flash-lite
TAVILY_API_KEY=YOUR_TAVILY_API_KEY

# Optional independent model overrides (otherwise use the provider defaults above).
# PLANNER_MODEL=gemini-3.5-flash-lite
# RESEARCH_MODEL=gemini-3.5-flash-lite
# REVIEWER_MODEL=gemini-3.5-flash-lite
# OUTREACH_MODEL=gemini-3.5-flash-lite
# Hard research ceiling, supported range 1–20; each workflow also respects its target.
MAX_RESEARCH_COMPANIES_PER_WORKFLOW=20

# Release 0.6 OAuth. Configure exact callbacks in each provider app; keep secrets server-only.
# Gmail: NEXT_PUBLIC_APP_URL/api/integrations/gmail/callback
# HubSpot: NEXT_PUBLIC_APP_URL/api/integrations/hubspot/callback
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET
HUBSPOT_CLIENT_ID=YOUR_HUBSPOT_CLIENT_ID
HUBSPOT_CLIENT_SECRET=YOUR_HUBSPOT_CLIENT_SECRET
# Exactly 32 random bytes, base64 encoded. Back up separately; there is no fallback or automatic rotation.
INTEGRATION_TOKEN_ENCRYPTION_KEY=YOUR_32_BYTE_BASE64_KEY

# Release 0.7. Disabled until the provider, worker and callback are configured.
AUTOMATION_ENABLED=false
TRIGGER_PROJECT_REF=YOUR_TRIGGER_PROJECT_REF
TRIGGER_SECRET_KEY=YOUR_TRIGGER_ENVIRONMENT_SECRET_KEY
# At least 32 random characters; identical in Next.js and Trigger.dev environments.
AUTOMATION_JOB_SIGNING_SECRET=YOUR_JOB_SIGNING_SECRET
# Canonical origin reachable from the worker (localhost is supported in local worker dev).
AUTOMATION_APP_URL=http://localhost:3000
# DEVELOPMENT ONLY: permit preparing a saved follow-up draft after 15 seconds.
AUTOMATION_ALLOW_TEST_JOBS=false
# Central model pricing. Empty means estimated cost is unknown, never zero.
# Map model names to {inputUsdPerMillion,outputUsdPerMillion,cachedInputUsdPerMillion?,cacheWriteUsdPerMillion?,reasoningUsdPerMillion?,version}.
AI_MODEL_PRICING_JSON={}
# IANA timezone for operational daily usage totals.
WORKSPACE_TIMEZONE=Asia/Qyzylorda
